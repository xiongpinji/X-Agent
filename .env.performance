# Performance Testing Configuration

## API Performance Test Configuration
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30

## Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xagent
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=20

## Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379/0

## Test Parameters

### API Performance Test
API_TEST_HEALTH_REQUESTS=5000
API_TEST_HEALTH_CONCURRENCY=50

API_TEST_LOGIN_REQUESTS=500
API_TEST_LOGIN_CONCURRENCY=10

API_TEST_WORKFLOWS_LIST_REQUESTS=2000
API_TEST_WORKFLOWS_LIST_CONCURRENCY=20

API_TEST_WORKFLOWS_CREATE_REQUESTS=500
API_TEST_WORKFLOWS_CREATE_CONCURRENCY=10

API_TEST_AGENTS_LIST_REQUESTS=2000
API_TEST_AGENTS_LIST_CONCURRENCY=20

API_TEST_AGENTS_CREATE_REQUESTS=500
API_TEST_AGENTS_CREATE_CONCURRENCY=10

### Database Performance Test
DB_TEST_INSERT_COUNT=10000
DB_TEST_SELECT_COUNT=10000
DB_TEST_UPDATE_COUNT=5000
DB_TEST_DELETE_COUNT=1000
DB_TEST_COMPLEX_QUERY_COUNT=1000
DB_TEST_TRANSACTION_COUNT=1000

### Locust Load Test
LOCUST_USERS=100
LOCUST_SPAWN_RATE=10
LOCUST_RUN_TIME=5m
LOCUST_HOST=http://localhost:8000

## Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

## Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=performance_tests.log

## Report Configuration
REPORT_FORMAT=json
REPORT_OUTPUT_DIR=./reports
SAVE_BASELINE=true
BASELINE_FILE=./baseline.json
