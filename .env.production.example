# ═══════════════════════════════════════════════════════════════════════════════
# X-Agent Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in all required values.
# All variables are prefixed with XAGENT_ (env_prefix in settings.py).
#
# REQUIRED fields are marked with [REQUIRED] — the application will refuse
# to start if these are missing or invalid in production mode.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────────────────────────────
XAGENT_APP_NAME=X-Agent
XAGENT_APP_MODE=production

# [REQUIRED] JWT signing secret — minimum 32 chars, must contain uppercase + digits
# Generate: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(64)))"
XAGENT_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_WITH_UPPERCASE_AND_DIGITS_000000

# [REQUIRED] Encryption key for sensitive data — minimum 32 chars
XAGENT_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING_WITH_UPPERCASE_AND_DIGITS_000

# ─── Database [REQUIRED] ────────────────────────────────────────────────────────
# PostgreSQL connection (asyncpg driver). Must NOT be sqlite or localhost.
XAGENT_DATABASE_URL=postgresql+asyncpg://xagent_user:STRONG_PASSWORD@db-host:5432/xagent_prod

# ─── Redis [REQUIRED] ───────────────────────────────────────────────────────────
# Used for: session storage, rate limiting, CSRF tokens, task queue, caching.
# Must NOT be empty in production (multi-instance shared state).
XAGENT_REDIS_URL=redis://redis-host:6379/0

# ─── Storage Backends [REQUIRED: must be external] ──────────────────────────────
XAGENT_MEMORY_BACKEND=postgres
XAGENT_TRACE_BACKEND=postgres
XAGENT_ADMIN_STORE_BACKEND=postgres

# ─── LLM Configuration ──────────────────────────────────────────────────────────
XAGENT_LLM_BACKEND=auto
XAGENT_LLM_FALLBACK_ORDER=openai,deepseek,anthropic,ollama
XAGENT_OPENAI_API_KEY=sk-your-openai-key
XAGENT_OPENAI_MODEL=gpt-4o-mini
# XAGENT_DEEPSEEK_API_KEY=
# XAGENT_DEEPSEEK_MODEL=deepseek-chat
# XAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── Vector Search ──────────────────────────────────────────────────────────────
XAGENT_QDRANT_URL=http://qdrant-host:6333
# XAGENT_QDRANT_API_KEY=
XAGENT_POSTGRES_ENABLE_VECTOR_SEARCH=false
XAGENT_POSTGRES_VECTOR_DIMENSIONS=1536

# ─── Security ───────────────────────────────────────────────────────────────────
XAGENT_REQUIRE_API_KEY=true
# XAGENT_BOOTSTRAP_API_KEY=your-bootstrap-key
XAGENT_AUDIT_HMAC_SECRET=CHANGE_ME_RANDOM_HMAC_SECRET_FOR_AUDIT_INTEGRITY_000000000
# XAGENT_GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Wildcard (*) is NOT allowed in production.
XAGENT_CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# ─── Observability ──────────────────────────────────────────────────────────────
# XAGENT_LANGFUSE_PUBLIC_KEY=
# XAGENT_LANGFUSE_SECRET_KEY=
# XAGENT_LANGFUSE_HOST=https://cloud.langfuse.com
XAGENT_OTEL_ENABLED=false
# XAGENT_OTEL_ENDPOINT=http://otel-collector:4317
# XAGENT_OTEL_SERVICE_NAME=xagent-api

# ─── KMS (Key Management) ───────────────────────────────────────────────────────
XAGENT_KMS_BACKEND=local
# XAGENT_KMS_VAULT_ADDR=http://vault:8200
# XAGENT_KMS_VAULT_TOKEN=
# XAGENT_KMS_AWS_KEY_ID=
# XAGENT_KMS_AWS_REGION=us-east-1

# ─── Prompt Guard ───────────────────────────────────────────────────────────────
XAGENT_PROMPT_GUARD_ENABLED=true
XAGENT_PROMPT_GUARD_ACTION=warn

# ─── GDPR ───────────────────────────────────────────────────────────────────────
XAGENT_GDPR_RESIDENCY_ENABLED=false
XAGENT_GDPR_DEFAULT_REGION=global
XAGENT_GDPR_PII_MASKING_ENABLED=true
XAGENT_GDPR_DATA_RETENTION_DAYS=365

# ─── Agent Limits ───────────────────────────────────────────────────────────────
XAGENT_MAX_ITERATIONS=4
XAGENT_DEFAULT_TOKEN_BUDGET=16000
XAGENT_DEFAULT_COST_BUDGET_USD=1.0
XAGENT_ENABLE_HIGH_RISK_TOOLS=false

# ─── Ultra Mode (Parallel Agents) ───────────────────────────────────────────────
XAGENT_ULTRA_MODE_ENABLED=false
XAGENT_ULTRA_MAX_AGENTS=4
XAGENT_ULTRA_BUDGET_TOKENS=50000
XAGENT_ULTRA_TIMEOUT_SECONDS=600

# ─── MoA (Mixture of Agents) ───────────────────────────────────────────────────
XAGENT_MOA_ENABLED=false
# XAGENT_MOA_MODELS=gpt-4o,claude-3,deepseek-v2
# XAGENT_MOA_STRATEGY=consensus

# ─── Audit Export ───────────────────────────────────────────────────────────────
# XAGENT_AUDIT_SYSLOG_HOST=syslog-host
# XAGENT_AUDIT_SYSLOG_PORT=514
# XAGENT_AUDIT_WEBHOOK_URL=https://siem.example.com/webhook
