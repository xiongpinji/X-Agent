# X-Agent Production Environment Configuration
# CRITICAL: All sensitive values MUST be set before deployment
# Generate secrets using: python scripts/generate_secrets.py

# ===== Application =====
XAGENT_APP_NAME=X-Agent
XAGENT_APP_VERSION=0.1.0
XAGENT_ENVIRONMENT=production
XAGENT_DEBUG=false

# ===== Database =====
# CRITICAL: Use PostgreSQL in production
XAGENT_DATABASE_URL=postgresql+asyncpg://xagent:PASSWORD@db.example.com:5432/xagent
XAGENT_DATABASE_POOL_SIZE=20
XAGENT_DATABASE_MAX_OVERFLOW=10
XAGENT_DATABASE_ECHO=false
XAGENT_POSTGRES_ENABLE_VECTOR_SEARCH=true
XAGENT_POSTGRES_VECTOR_DIMENSIONS=1536

# ===== Memory Store =====
XAGENT_MEMORY_BACKEND=postgres
XAGENT_MEMORY_STORE_PATH=
XAGENT_EMBEDDING_BACKEND=openai
XAGENT_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
XAGENT_OPENAI_EMBEDDING_DIMENSIONS=3072

# ===== Trace Store =====
XAGENT_TRACE_STORE_PATH=
XAGENT_RUN_STORE_PATH=
XAGENT_WORKFLOW_STORE_PATH=
XAGENT_WORKFLOW_RUN_STORE_PATH=
XAGENT_WORKFLOW_SCHEDULE_STORE_PATH=

# ===== Approval & Audit =====
XAGENT_APPROVAL_STORE_PATH=
XAGENT_AUDIT_STORE_PATH=
# CRITICAL: Generate using: python scripts/generate_secrets.py
XAGENT_AUDIT_HMAC_SECRET=REPLACE_WITH_GENERATED_SECRET
XAGENT_API_KEY_STORE_PATH=
XAGENT_TOOL_EXECUTION_STORE_PATH=

# ===== GitHub Webhook =====
# CRITICAL: Generate using: python scripts/generate_secrets.py
XAGENT_GITHUB_WEBHOOK_SECRET=REPLACE_WITH_GENERATED_SECRET

# ===== Cache (Redis) =====
# CRITICAL: Redis is required in production
XAGENT_REDIS_URL=redis://redis.example.com:6379/0
XAGENT_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
XAGENT_REDIS_DB=0
XAGENT_CACHE_TTL_DEFAULT=3600
XAGENT_CACHE_TTL_SHORT=300
XAGENT_CACHE_TTL_LONG=86400

# ===== LLM Configuration =====
XAGENT_LLM_BACKEND=openai
XAGENT_LLM_FALLBACK_ORDER=deepseek,anthropic
# CRITICAL: Set your API keys
XAGENT_OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
XAGENT_OPENAI_MODEL=gpt-4o
XAGENT_DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
XAGENT_DEEPSEEK_MODEL=deepseek-chat
XAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
XAGENT_ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# ===== Agent Configuration =====
XAGENT_MAX_ITERATIONS=10
XAGENT_DEFAULT_TOKEN_BUDGET=32000
XAGENT_DEFAULT_COST_BUDGET_USD=10.0
XAGENT_ENABLE_HIGH_RISK_TOOLS=false

# ===== Security =====
# CRITICAL: Generate using: python scripts/generate_secrets.py
XAGENT_JWT_SECRET=REPLACE_WITH_GENERATED_SECRET_MIN_64_CHARS
XAGENT_JWT_ALGORITHM=HS256
XAGENT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
XAGENT_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# CRITICAL: Generate using: python scripts/generate_secrets.py
XAGENT_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_SECRET_MIN_64_CHARS
XAGENT_ENCRYPTION_ALGORITHM=AES-256-GCM
XAGENT_BCRYPT_COST=12
XAGENT_REQUIRE_API_KEY=true
XAGENT_BOOTSTRAP_API_KEY=REPLACE_WITH_BOOTSTRAP_API_KEY
XAGENT_API_KEY_EXPIRATION_DAYS=90

# ===== CORS =====
# CRITICAL: Set specific origins, never use wildcard (*)
XAGENT_CORS_ORIGINS=https://app.example.com,https://www.example.com
XAGENT_CORS_ALLOW_CREDENTIALS=true
XAGENT_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
XAGENT_CORS_ALLOW_HEADERS=Authorization,Content-Type

# ===== Rate Limiting =====
XAGENT_RATE_LIMIT_DEFAULT=100
XAGENT_RATE_LIMIT_AUTH=20
XAGENT_RATE_LIMIT_AGENT_RUN=10
XAGENT_RATE_LIMIT_ADMIN=500
XAGENT_RATE_LIMIT_WINDOW_SECONDS=60

# ===== Account Lockout =====
XAGENT_MAX_LOGIN_ATTEMPTS=5
XAGENT_LOCKOUT_DURATION_MINUTES=30

# ===== HTTPS/TLS =====
# CRITICAL: HTTPS is required in production
XAGENT_REQUIRE_HTTPS=true
XAGENT_SSL_CERT_PATH=/etc/ssl/certs/xagent.crt
XAGENT_SSL_KEY_PATH=/etc/ssl/private/xagent.key

# ===== Logging =====
XAGENT_LOG_LEVEL=INFO
XAGENT_LOG_FORMAT=json
XAGENT_LOG_OUTPUT=both
XAGENT_LOG_FILE=/var/log/xagent/xagent.log
XAGENT_LOG_MAX_BYTES=104857600
XAGENT_LOG_BACKUP_COUNT=30

# ===== Tracing =====
XAGENT_TRACE_ENABLED=true
XAGENT_TRACE_SAMPLE_RATE=0.1

# ===== Langfuse =====
XAGENT_LANGFUSE_ENABLED=true
XAGENT_LANGFUSE_PUBLIC_KEY=REPLACE_WITH_LANGFUSE_PUBLIC_KEY
XAGENT_LANGFUSE_SECRET_KEY=REPLACE_WITH_LANGFUSE_SECRET_KEY
XAGENT_LANGFUSE_HOST=https://langfuse.example.com

# ===== Prometheus =====
XAGENT_PROMETHEUS_ENABLED=true
XAGENT_PROMETHEUS_PORT=8001
XAGENT_PROMETHEUS_PATH=/metrics

# ===== Sentry =====
XAGENT_SENTRY_ENABLED=true
XAGENT_SENTRY_DSN=REPLACE_WITH_SENTRY_DSN
XAGENT_SENTRY_ENVIRONMENT=production
XAGENT_SENTRY_TRACES_SAMPLE_RATE=0.1

# ===== Performance Monitoring =====
XAGENT_SLOW_QUERY_THRESHOLD_MS=1000
XAGENT_SLOW_API_THRESHOLD_MS=5000
XAGENT_METRICS_ENABLED=true
XAGENT_METRICS_RETENTION_DAYS=90

# ===== Qdrant Vector Database =====
XAGENT_QDRANT_URL=https://qdrant.example.com:6333
XAGENT_QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY

# ===== Browser =====
XAGENT_PLAYWRIGHT_HEADLESS=true

# ===== Feature Flags =====
XAGENT_FEATURE_SELF_EVOLUTION=true
XAGENT_FEATURE_SKILL_MARKETPLACE=true
XAGENT_FEATURE_MULTI_AGENT=true
XAGENT_FEATURE_RPA=true
XAGENT_FEATURE_MULTIMODAL=true

# ===== SkillHub =====
XAGENT_SKILLHUB_URL=https://skillhub.cn
XAGENT_SKILLHUB_API_KEY=REPLACE_WITH_SKILLHUB_API_KEY

# ===== Feishu Integration =====
XAGENT_FEISHU_APP_ID=REPLACE_WITH_FEISHU_APP_ID
XAGENT_FEISHU_APP_SECRET=REPLACE_WITH_FEISHU_APP_SECRET

# ===== DingTalk Integration =====
XAGENT_DINGTALK_WEBHOOK_URL=REPLACE_WITH_DINGTALK_WEBHOOK_URL

# ===== WeChat Integration =====
XAGENT_WECHAT_APP_ID=REPLACE_WITH_WECHAT_APP_ID
XAGENT_WECHAT_APP_SECRET=REPLACE_WITH_WECHAT_APP_SECRET

# ===== Email Configuration =====
XAGENT_SMTP_HOST=smtp.example.com
XAGENT_SMTP_PORT=587
XAGENT_SMTP_USER=noreply@example.com
XAGENT_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
XAGENT_EMAIL_FROM=noreply@x-agent.example.com

# ===== S3 Storage =====
XAGENT_S3_ENDPOINT=https://s3.example.com
XAGENT_S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
XAGENT_S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY
XAGENT_S3_BUCKET=xagent-production-data
