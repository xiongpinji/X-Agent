# ============================================
# X-Agent Configuration Template
# Copy this file to .env and fill in your values.
# Do not commit .env.
# ============================================

# --- Core ---
XAGENT_APP_MODE=development
XAGENT_MODE=lite
XAGENT_REQUIRE_API_KEY=false
XAGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM (configure at least one non-mock backend for real tasks) ---
XAGENT_LLM_BACKEND=mock
XAGENT_DEEPSEEK_API_KEY=
XAGENT_DEEPSEEK_MODEL=deepseek-chat
XAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
XAGENT_OPENAI_API_KEY=
XAGENT_OPENAI_MODEL=gpt-4o-mini
XAGENT_ANTHROPIC_API_KEY=

# --- Security (generated by scripts/generate_secrets.py) ---
XAGENT_JWT_SECRET=
XAGENT_ENCRYPTION_KEY=
XAGENT_AUDIT_HMAC_SECRET=
XAGENT_BOOTSTRAP_API_KEY=

# --- Lite storage (no Docker required) ---
XAGENT_DATABASE_URL=sqlite+aiosqlite:///~/.xagent/data.db
XAGENT_REDIS_URL=
XAGENT_QDRANT_URL=
XAGENT_MEMORY_BACKEND=memory
XAGENT_TRACE_BACKEND=jsonl
XAGENT_RUN_STORE_PATH=~/.xagent/runs.jsonl
XAGENT_TRACE_STORE_PATH=~/.xagent/traces.jsonl
XAGENT_AUDIT_STORE_PATH=~/.xagent/audit.jsonl

# --- Full Docker stack ---
DB_USER=xagent
DB_PASSWORD=
DB_NAME=xagent_db
DB_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379
QDRANT_API_KEY=
QDRANT_PORT=6333
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_PORT=7687

# --- Optional observability ---
XAGENT_LANGFUSE_PUBLIC_KEY=
XAGENT_LANGFUSE_SECRET_KEY=
XAGENT_LANGFUSE_HOST=
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# --- Optional integrations ---
XAGENT_GITHUB_TOKEN=
XAGENT_GITHUB_WEBHOOK_SECRET=
XAGENT_FEISHU_APP_ID=
XAGENT_FEISHU_APP_SECRET=
XAGENT_FEISHU_ENCRYPT_KEY=
XAGENT_TELEGRAM_BOT_TOKEN=
XAGENT_TELEGRAM_WEBHOOK_SECRET=
XAGENT_TELEGRAM_BASE_URL=

# --- Runtime flags ---
XAGENT_ENABLE_HIGH_RISK_TOOLS=false
XAGENT_PLAYWRIGHT_HEADLESS=true
LOG_LEVEL=INFO
