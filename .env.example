# X-Agent Configuration

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://xagent:xagent@localhost:5432/xagent
REDIS_URL=redis://localhost:6379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# ⚠️ SECURITY: Generate using: python scripts/generate_secrets.py
NEO4J_PASSWORD=REPLACE_WITH_OUTPUT_FROM_generate_secrets_py

# ===== LLM APIs =====
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
XAGENT_LLM_BACKEND=mock
XAGENT_LLM_FALLBACK_ORDER=openai,deepseek,mock
XAGENT_RUNTIME_DIR=.xagent_runtime
XAGENT_MEMORY_BACKEND=jsonl
XAGENT_TRACE_BACKEND=jsonl
XAGENT_MEMORY_STORE_PATH=.xagent_runtime/memory.jsonl
XAGENT_TRACE_STORE_PATH=.xagent_runtime/traces.jsonl
XAGENT_RUN_STORE_PATH=.xagent_runtime/runs.jsonl
XAGENT_DATABASE_URL=postgresql://xagent:xagent@localhost:5432/xagent
XAGENT_CORS_ORIGINS=*

# ===== LLM Configuration =====
LLM_PRIORITY=openai,claude,deepseek
DEFAULT_MODEL=gpt-4o
XAGENT_OPENAI_MODEL=gpt-5.2
XAGENT_DEEPSEEK_MODEL=deepseek-chat
XAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS_PER_RESPONSE=4096
CONTEXT_WINDOW_TOKENS=32000

# ===== Agent Configuration =====
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=5
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_BASE_DELAY=1.0

# ===== Security =====
# ⚠️ CRITICAL: Generate secure secrets using: python scripts/generate_secrets.py
# NEVER use these placeholder values in production!
JWT_SECRET=REPLACE_WITH_OUTPUT_FROM_generate_secrets_py
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_FROM_generate_secrets_py
BCRYPT_COST=12

# ===== Rate Limiting =====
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=20
RATE_LIMIT_AGENT_RUN=10
RATE_LIMIT_ADMIN=500
RATE_LIMIT_WINDOW_SECONDS=60

# ===== Logging =====
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json or text
LOG_OUTPUT=stdout  # stdout or file

# ===== Monitoring =====
PROMETHEUS_ENABLED=true
SENTRY_DSN=  # Optional: Sentry error tracking DSN

# ===== Feature Flags =====
FEATURE_SELF_EVOLUTION=true
FEATURE_SKILL_MARKETPLACE=true
FEATURE_MULTI_AGENT=true
FEATURE_RPA=true
FEATURE_MULTIMODAL=true

# ===== Skillhub =====
SKILLHUB_URL=https://skillhub.cn
SKILLHUB_API_KEY=  # Optional

# ===== External Integrations =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
DINGTALK_WEBHOOK_URL=
WECOM_WEBHOOK_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ===== Browser / Retrieval / Observability =====
XAGENT_QDRANT_URL=http://localhost:6333
XAGENT_QDRANT_API_KEY=
XAGENT_LANGFUSE_PUBLIC_KEY=
XAGENT_LANGFUSE_SECRET_KEY=
XAGENT_LANGFUSE_HOST=http://localhost:3000
XAGENT_PLAYWRIGHT_HEADLESS=true

# ===== Email (for password reset, alerts) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@x-agent.ai
SMTP_PASSWORD=
EMAIL_FROM=noreply@x-agent.ai

# ===== Storage =====
S3_ENDPOINT=http://localhost:9000
# ⚠️ SECURITY: Generate using: python scripts/generate_secrets.py
S3_ACCESS_KEY=REPLACE_WITH_OUTPUT_FROM_generate_secrets_py
S3_SECRET_KEY=REPLACE_WITH_OUTPUT_FROM_generate_secrets_py
S3_BUCKET=xagent-data

# ===== Development =====
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RELOAD=false
