# ============================================================================
# X-Agent — CORE settings actually read by the app (env_prefix = XAGENT_)
# ----------------------------------------------------------------------------
# IMPORTANT: the application only reads variables prefixed with XAGENT_.
# Un-prefixed vars further below are reference/aspirational and are IGNORED by
# the core settings loader. Set the XAGENT_* vars here for a working config.
#
# QUICK START (development): you can run with NO secrets at all —
#   pip install -r requirements.txt
#   uvicorn backend.app.main:app --reload
# In development the app auto-generates ephemeral secrets (with warnings).
#
# PRODUCTION: you MUST set XAGENT_APP_MODE=production AND provide strong,
# explicit secrets below (>=32 chars, with uppercase + digits). Generate via:
#   python scripts/generate_secrets.py
# ============================================================================

# --- Mode ---
XAGENT_APP_MODE=development            # development | production

# --- Security secrets (REQUIRED in production; auto-generated in dev) ---
XAGENT_AUDIT_HMAC_SECRET=              # audit log signing key (REQUIRED in prod)
XAGENT_JWT_SECRET=                     # >=32 chars, uppercase+digits (prod)
XAGENT_ENCRYPTION_KEY=                 # >=32 chars (prod)

# --- API access ---
XAGENT_REQUIRE_API_KEY=false           # set true to require x-api-key on all routes
XAGENT_BOOTSTRAP_API_KEY=              # optional admin bootstrap key for programmatic access

# --- LLM (default backend is "mock" — no key needed to try it out) ---
XAGENT_LLM_BACKEND=mock                # mock | openai | deepseek | ...
XAGENT_OPENAI_API_KEY=                 # required only if LLM_BACKEND=openai
XAGENT_DEEPSEEK_API_KEY=

# --- Storage / data (defaults to local SQLite + in-memory; no setup needed) ---
XAGENT_DATABASE_URL=sqlite:///./data/xagent.db
XAGENT_MEMORY_BACKEND=memory           # memory | jsonl | postgres
XAGENT_TRACE_BACKEND=memory

# --- Optional integrations (leave blank to disable) ---
XAGENT_QDRANT_URL=                     # leave EMPTY to use in-memory vector fallback
XAGENT_REDIS_URL=
XAGENT_LANGFUSE_PUBLIC_KEY=
XAGENT_LANGFUSE_SECRET_KEY=
XAGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# Reference / aspirational config below (NOT all read by core settings loader)
# ============================================================================

# X-Agent Configuration

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://xagent:xagent@localhost:5432/xagent
REDIS_URL=redis://localhost:6379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# ⚠️ SECURITY: Generate using: python scripts/generate_secrets.py
NEO4J_PASSWORD=REPLACE_WITH_OUTPUT_FROM_generate_secrets_py

# ===== LLM APIs =====
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
XAGENT_LLM_BACKEND=mock
XAGENT_LLM_FALLBACK_ORDER=openai,deepseek,mock
XAGENT_RUNTIME_DIR=.xagent_runtime
XAGENT_MEMORY_BACKEND=jsonl
XAGENT_TRACE_BACKEND=jsonl
XAGENT_MEMORY_STORE_PATH=.xagent_runtime/memory.jsonl
XAGENT_TRACE_STORE_PATH=.xagent_runtime/traces.jsonl
XAGENT_RUN_STORE_PATH=.xagent_runtime/runs.jsonl
XAGENT_DATABASE_URL=postgresql://xagent:xagent@localhost:5432/xagent
XAGENT_CORS_ORIGINS=*

# ===== LLM Configuration =====
LLM_PRIORITY=openai,claude,deepseek
DEFAULT_MODEL=gpt-4o
XAGENT_OPENAI_MODEL=gpt-5.2
XAGENT_DEEPSEEK_MODEL=deepseek-chat
XAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS_PER_RESPONSE=4096
CONTEXT_WINDOW_TOKENS=32000

# ===== Agent Configuration =====
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=5
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_BASE_DELAY=1.0

# ===== Security =====
# ⚠️ CRITICAL: Generate secure secrets using: python scripts/generate_secrets.py
# NEVER use these placeholder values in production!
JWT_SECRET=REPLACE_WITH_OUTPUT_FROM_generate_secrets_py
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_FROM_generate_secrets_py
BCRYPT_COST=12

# ===== Rate Limiting =====
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=20
RATE_LIMIT_AGENT_RUN=10
RATE_LIMIT_ADMIN=500
RATE_LIMIT_WINDOW_SECONDS=60

# ===== Logging =====
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json or text
LOG_OUTPUT=stdout  # stdout or file

# ===== Monitoring =====
PROMETHEUS_ENABLED=true
SENTRY_DSN=  # Optional: Sentry error tracking DSN

# ===== Feature Flags =====
FEATURE_SELF_EVOLUTION=true
FEATURE_SKILL_MARKETPLACE=true
FEATURE_MULTI_AGENT=true
FEATURE_RPA=true
FEATURE_MULTIMODAL=true

# ===== Skillhub =====
SKILLHUB_URL=https://skillhub.cn
SKILLHUB_API_KEY=  # Optional

# ===== External Integrations =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
DINGTALK_WEBHOOK_URL=
WECOM_WEBHOOK_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ===== Browser / Retrieval / Observability =====
XAGENT_QDRANT_URL=http://localhost:6333
XAGENT_QDRANT_API_KEY=
XAGENT_LANGFUSE_PUBLIC_KEY=
XAGENT_LANGFUSE_SECRET_KEY=
XAGENT_LANGFUSE_HOST=http://localhost:3000
XAGENT_PLAYWRIGHT_HEADLESS=true

# ===== Email (for password reset, alerts) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@x-agent.ai
SMTP_PASSWORD=
EMAIL_FROM=noreply@x-agent.ai

# ===== Storage =====
S3_ENDPOINT=http://localhost:9000
# ⚠️ SECURITY: Generate using: python scripts/generate_secrets.py
S3_ACCESS_KEY=REPLACE_WITH_OUTPUT_FROM_generate_secrets_py
S3_SECRET_KEY=REPLACE_WITH_OUTPUT_FROM_generate_secrets_py
S3_BUCKET=xagent-data

# ===== Development =====
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RELOAD=false
