# X-Agent 监控系统环境变量配置

# ============================================================================
# Prometheus Configuration
# ============================================================================

# Prometheus scrape interval (seconds)
PROMETHEUS_SCRAPE_INTERVAL=15

# Prometheus evaluation interval (seconds)
PROMETHEUS_EVALUATION_INTERVAL=15

# Prometheus data retention time
PROMETHEUS_RETENTION_TIME=30d

# Prometheus storage size limit
PROMETHEUS_RETENTION_SIZE=50GB

# ============================================================================
# Grafana Configuration
# ============================================================================

# Grafana admin username
GF_SECURITY_ADMIN_USER=admin

# Grafana admin password (CHANGE IN PRODUCTION!)
GF_SECURITY_ADMIN_PASSWORD=admin

# Grafana server root URL
GF_SERVER_ROOT_URL=http://localhost:3000

# Grafana allow sign up
GF_USERS_ALLOW_SIGN_UP=false

# Grafana cookie secure (set to true in production with HTTPS)
GF_SECURITY_COOKIE_SECURE=false

# Grafana cookie httponly
GF_SECURITY_COOKIE_HTTPONLY=true

# ============================================================================
# Elasticsearch Configuration
# ============================================================================

# Elasticsearch Java options
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Elasticsearch security enabled
ELASTICSEARCH_SECURITY_ENABLED=false

# Elasticsearch username
ELASTICSEARCH_USER=elastic

# Elasticsearch password
ELASTICSEARCH_PASSWORD=changeme

# Elasticsearch host
ELASTICSEARCH_HOST=elasticsearch

# Elasticsearch port
ELASTICSEARCH_PORT=9200

# ============================================================================
# Logstash Configuration
# ============================================================================

# Logstash Java options
LS_JAVA_OPTS=-Xmx256m -Xms256m

# Logstash pipeline workers
LOGSTASH_PIPELINE_WORKERS=4

# Logstash batch size
LOGSTASH_BATCH_SIZE=1000

# ============================================================================
# Jaeger Configuration
# ============================================================================

# Jaeger agent host
JAEGER_HOST=localhost

# Jaeger agent port (UDP)
JAEGER_PORT=6831

# Jaeger collector host
JAEGER_COLLECTOR_HOST=localhost

# Jaeger collector port
JAEGER_COLLECTOR_PORT=14268

# Jaeger sampler type (const, probabilistic, rate_limiting, remote)
JAEGER_SAMPLER_TYPE=probabilistic

# Jaeger sampler parameter (0.0 to 1.0 for probabilistic)
JAEGER_SAMPLER_PARAM=0.1

# Jaeger OTLP enabled
COLLECTOR_OTLP_ENABLED=true

# ============================================================================
# AlertManager Configuration
# ============================================================================

# Slack webhook URL for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty service key
PAGERDUTY_SERVICE_KEY=your-pagerduty-service-key

# AlertManager resolve timeout (seconds)
ALERTMANAGER_RESOLVE_TIMEOUT=300

# ============================================================================
# Application Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log directory
LOG_DIR=/var/log/xagent

# Log file max size (bytes)
LOG_FILE_MAX_SIZE=104857600  # 100MB

# Log file backup count
LOG_FILE_BACKUP_COUNT=10

# Error log file max size (bytes)
ERROR_LOG_FILE_MAX_SIZE=52428800  # 50MB

# Error log file backup count
ERROR_LOG_FILE_BACKUP_COUNT=5

# Remote logging URL (optional)
LOG_REMOTE_URL=

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL host
POSTGRES_HOST=postgres

# PostgreSQL port
POSTGRES_PORT=5432

# PostgreSQL user
POSTGRES_USER=xagent

# PostgreSQL password
POSTGRES_PASSWORD=xagent

# PostgreSQL database
POSTGRES_DB=xagent

# PostgreSQL connection pool size
DB_POOL_SIZE=20

# PostgreSQL max overflow
DB_MAX_OVERFLOW=40

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis host
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis password (optional)
REDIS_PASSWORD=

# Redis database
REDIS_DB=0

# ============================================================================
# Qdrant Configuration
# ============================================================================

# Qdrant host
QDRANT_HOST=qdrant

# Qdrant port
QDRANT_PORT=6333

# Qdrant API key
QDRANT_API_KEY=qdrant_key

# ============================================================================
# Application Configuration
# ============================================================================

# Application name
APP_NAME=x-agent

# Application mode (development, production)
APP_MODE=production

# Application version
APP_VERSION=0.1.0

# Application host
APP_HOST=0.0.0.0

# Application port
APP_PORT=8000

# CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Require API key
REQUIRE_API_KEY=false

# ============================================================================
# Monitoring Configuration
# ============================================================================

# Enable Prometheus metrics
ENABLE_PROMETHEUS=true

# Enable Jaeger tracing
ENABLE_JAEGER=true

# Enable structured logging
ENABLE_STRUCTURED_LOGGING=true

# Metrics scrape path
METRICS_PATH=/metrics

# Health check path
HEALTH_PATH=/health

# Readiness check path
READY_PATH=/ready

# ============================================================================
# Security Configuration
# ============================================================================

# Secret key for JWT tokens
SECRET_KEY=your-secret-key-change-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# JWT expiration time (seconds)
JWT_EXPIRATION_TIME=3600

# ============================================================================
# Feature Flags
# ============================================================================

# Enable debug mode
DEBUG=false

# Enable CORS
ENABLE_CORS=true

# Enable API documentation
ENABLE_DOCS=true

# ============================================================================
# Backup Configuration
# ============================================================================

# Backup directory
BACKUP_DIR=/backups

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Enable automatic backups
ENABLE_AUTO_BACKUP=true

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# ============================================================================
# Notification Configuration
# ============================================================================

# Email SMTP host
SMTP_HOST=smtp.gmail.com

# Email SMTP port
SMTP_PORT=587

# Email SMTP user
SMTP_USER=your-email@gmail.com

# Email SMTP password
SMTP_PASSWORD=your-app-password

# Email from address
EMAIL_FROM=noreply@xagent.com

# Email to address for alerts
EMAIL_TO=admin@xagent.com

# ============================================================================
# Performance Configuration
# ============================================================================

# Worker threads
WORKER_THREADS=4

# Max connections
MAX_CONNECTIONS=1000

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# ============================================================================
# Notes
# ============================================================================

# 1. 在生产环境中，务必更改所有默认密码和密钥
# 2. 使用强密码和安全的密钥
# 3. 启用HTTPS/TLS
# 4. 配置防火墙规则
# 5. 定期备份数据
# 6. 监控系统资源使用
# 7. 定期更新依赖包
# 8. 启用审计日志
# 9. 配置告警通知
# 10. 测试灾难恢复计划
