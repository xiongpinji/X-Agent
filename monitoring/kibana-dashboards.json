{
  "version": "8.11.0",
  "objects": [
    {
      "type": "dashboard",
      "id": "xagent-logs-overview",
      "attributes": {
        "title": "X-Agent Logs Overview",
        "description": "Overview of X-Agent application logs",
        "panels": [
          {
            "version": "8.11.0",
            "gridData": {
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 15
            },
            "type": "visualization",
            "embeddableConfig": {},
            "panelIndex": "1",
            "embeddableConfig": {
              "vis": {
                "colors": {
                  "ERROR": "#F2495C",
                  "WARN": "#FF9830",
                  "INFO": "#73BF69",
                  "DEBUG": "#5794F2"
                }
              }
            },
            "visualization": {
              "title": "Log Level Distribution",
              "type": "pie",
              "params": {
                "addTooltip": true,
                "addLegend": true,
                "legendPosition": "right",
                "isDonut": false
              },
              "aggs": [
                {
                  "id": "1",
                  "enabled": true,
                  "type": "count",
                  "schema": "metric",
                  "params": {}
                },
                {
                  "id": "2",
                  "enabled": true,
                  "type": "terms",
                  "schema": "segment",
                  "params": {
                    "field": "log_level",
                    "size": 10,
                    "order": "desc",
                    "orderBy": "1"
                  }
                }
              ]
            }
          }
        ],
        "timeRestore": true,
        "timeFrom": "now-24h",
        "timeTo": "now",
        "refreshInterval": {
          "pause": false,
          "value": 10000
        }
      }
    },
    {
