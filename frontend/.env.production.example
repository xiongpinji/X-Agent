# Frontend environment template
# Copy to frontend/.env.local or frontend/.env.production for local deployment.

# Enable the Resources BFF (switch from mock data to real backend)
VITE_PANDA_RESOURCES_BFF=true
VITE_PANDA_RESOURCES_BFF_ENDPOINT=/api/v1/workbench/resources

# Backend API URL
VITE_API_BASE_URL=http://localhost:8000

# Auth token storage key
VITE_AUTH_TOKEN_KEY=auth_token
