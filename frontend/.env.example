# X-Agent Web UI Environment Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# Application Configuration
VITE_APP_NAME=X-Agent
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_CHAT=true
VITE_ENABLE_TASKS=true
VITE_ENABLE_TOOLS=true
VITE_ENABLE_MEMORY=true
VITE_ENABLE_AGENTS=true

# Debug Mode
VITE_DEBUG=false

# Analytics (optional)
VITE_ANALYTICS_ID=

# Authentication
VITE_AUTH_ENABLED=false
VITE_AUTH_PROVIDER=local
