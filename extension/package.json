{
  "name": "x-agent-chrome-extension",
  "version": "0.2.0-alpha",
  "description": "X-Agent Browser Extension - Intelligent web automation powered by AI",
  "author": "X-Agent Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/x-agent/x-agent-core.git",
    "directory": "extension"
  },
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "package": "zip -r x-agent-extension.zip . -x 'node_modules/*' '.git/*' 'tests/*' 'scripts/*' '*.md'",
    "clean": "rm -rf coverage/ x-agent-extension.zip"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "chrome-extension",
    "browser-automation",
    "web-scraping",
    "form-filling",
    "ai",
    "x-agent"
  ]
}
