{
  "db_path": "~/.xagent/local.db",
  "db_timeout": 30.0,
  "db_enable_wal": true,
  "db_enable_foreign_keys": true,
  "sync_enabled": true,
  "sync_interval_seconds": 300,
  "sync_batch_size": 100,
  "sync_max_retries": 3,
  "sync_retry_delay_seconds": 60,
  "sync_timeout_seconds": 30,
  "sync_default_strategy": "last_write_wins",
  "encryption_enabled": true,
  "encryption_algorithm": "AES-256-GCM",
  "encryption_key_size": 32,
  "encryption_iterations": 100000,
  "cache_enabled": true,
  "cache_ttl_seconds": 3600,
  "cache_max_size_mb": 100,
  "cache_cleanup_interval_seconds": 600,
  "offline_queue_enabled": true,
  "offline_queue_max_size": 10000,
  "preload_enabled": true,
  "preload_batch_size": 50,
  "preload_priority_threshold": 0.5,
  "monitoring_enabled": true,
  "monitoring_log_level": "INFO",
  "monitoring_metrics_enabled": true,
  "cloud_api_url": "http://localhost:8000",
  "cloud_api_timeout": 30,
  "cloud_api_retry_count": 3,
  "security_enable_tls": true,
  "security_verify_ssl": true,
  "security_api_key_encryption": true
}
