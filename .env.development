# X-Agent Development Environment Configuration
# Copy this file to .env.development and customize for your environment

# ===== Application =====
XAGENT_APP_NAME=X-Agent
XAGENT_APP_VERSION=0.1.0
XAGENT_ENVIRONMENT=development
XAGENT_DEBUG=true

# ===== Database =====
XAGENT_DATABASE_URL=sqlite:///./data/xagent.db
XAGENT_DATABASE_POOL_SIZE=5
XAGENT_DATABASE_MAX_OVERFLOW=2
XAGENT_DATABASE_ECHO=false
XAGENT_POSTGRES_ENABLE_VECTOR_SEARCH=false
XAGENT_POSTGRES_VECTOR_DIMENSIONS=1536

# ===== Memory Store =====
XAGENT_MEMORY_BACKEND=memory
XAGENT_MEMORY_STORE_PATH=data/memory.jsonl
XAGENT_EMBEDDING_BACKEND=local
XAGENT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== Trace Store =====
XAGENT_TRACE_STORE_PATH=data/traces.jsonl
XAGENT_RUN_STORE_PATH=data/runs.jsonl
XAGENT_WORKFLOW_STORE_PATH=data/workflows.json
XAGENT_WORKFLOW_RUN_STORE_PATH=data/workflow_runs.jsonl
XAGENT_WORKFLOW_SCHEDULE_STORE_PATH=data/workflow_schedules.json

# ===== Approval & Audit =====
XAGENT_APPROVAL_STORE_PATH=data/approvals.json
XAGENT_AUDIT_STORE_PATH=data/audit.jsonl
XAGENT_AUDIT_HMAC_SECRET=dev-hmac-secret-change-in-production
XAGENT_API_KEY_STORE_PATH=data/api_keys.json
XAGENT_TOOL_EXECUTION_STORE_PATH=data/tool_executions.json

# ===== Cache (Redis) =====
XAGENT_REDIS_URL=
XAGENT_REDIS_PASSWORD=
XAGENT_REDIS_DB=0
XAGENT_CACHE_TTL_DEFAULT=3600
XAGENT_CACHE_TTL_SHORT=300
XAGENT_CACHE_TTL_LONG=86400

# ===== LLM Configuration =====
XAGENT_LLM_BACKEND=mock
XAGENT_LLM_FALLBACK_ORDER=
XAGENT_OPENAI_API_KEY=
XAGENT_OPENAI_MODEL=gpt-4o-mini
XAGENT_DEEPSEEK_API_KEY=
XAGENT_DEEPSEEK_MODEL=deepseek-chat
XAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
XAGENT_ANTHROPIC_API_KEY=

# ===== Agent Configuration =====
XAGENT_MAX_ITERATIONS=4
XAGENT_DEFAULT_TOKEN_BUDGET=16000
XAGENT_DEFAULT_COST_BUDGET_USD=1.0
XAGENT_ENABLE_HIGH_RISK_TOOLS=false

# ===== Security =====
XAGENT_JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
XAGENT_JWT_ALGORITHM=HS256
XAGENT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
XAGENT_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
XAGENT_ENCRYPTION_KEY=dev-encryption-key-change-in-production-min-32-chars
XAGENT_ENCRYPTION_ALGORITHM=AES-256-GCM
XAGENT_BCRYPT_COST=12
XAGENT_REQUIRE_API_KEY=false
XAGENT_BOOTSTRAP_API_KEY=
XAGENT_API_KEY_EXPIRATION_DAYS=90

# ===== CORS =====
XAGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
XAGENT_CORS_ALLOW_CREDENTIALS=true
XAGENT_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
XAGENT_CORS_ALLOW_HEADERS=*

# ===== Rate Limiting =====
XAGENT_RATE_LIMIT_DEFAULT=100
XAGENT_RATE_LIMIT_AUTH=20
XAGENT_RATE_LIMIT_AGENT_RUN=10
XAGENT_RATE_LIMIT_ADMIN=500
XAGENT_RATE_LIMIT_WINDOW_SECONDS=60

# ===== Account Lockout =====
XAGENT_MAX_LOGIN_ATTEMPTS=5
XAGENT_LOCKOUT_DURATION_MINUTES=15

# ===== HTTPS/TLS =====
XAGENT_REQUIRE_HTTPS=false
XAGENT_SSL_CERT_PATH=
XAGENT_SSL_KEY_PATH=

# ===== Logging =====
XAGENT_LOG_LEVEL=INFO
XAGENT_LOG_FORMAT=json
XAGENT_LOG_OUTPUT=stdout
XAGENT_LOG_FILE=logs/xagent.log
XAGENT_LOG_MAX_BYTES=10485760
XAGENT_LOG_BACKUP_COUNT=10

# ===== Tracing =====
XAGENT_TRACE_ENABLED=true
XAGENT_TRACE_SAMPLE_RATE=1.0

# ===== Langfuse =====
XAGENT_LANGFUSE_ENABLED=false
XAGENT_LANGFUSE_PUBLIC_KEY=
XAGENT_LANGFUSE_SECRET_KEY=
XAGENT_LANGFUSE_HOST=http://localhost:3000

# ===== Prometheus =====
XAGENT_PROMETHEUS_ENABLED=false
XAGENT_PROMETHEUS_PORT=8001
XAGENT_PROMETHEUS_PATH=/metrics

# ===== Sentry =====
XAGENT_SENTRY_ENABLED=false
XAGENT_SENTRY_DSN=
XAGENT_SENTRY_ENVIRONMENT=development
XAGENT_SENTRY_TRACES_SAMPLE_RATE=1.0

# ===== Performance Monitoring =====
XAGENT_SLOW_QUERY_THRESHOLD_MS=1000
XAGENT_SLOW_API_THRESHOLD_MS=5000
XAGENT_METRICS_ENABLED=true
XAGENT_METRICS_RETENTION_DAYS=30

# ===== Qdrant Vector Database =====
XAGENT_QDRANT_URL=http://localhost:6333
XAGENT_QDRANT_API_KEY=

# ===== Browser =====
XAGENT_PLAYWRIGHT_HEADLESS=true

# ===== Feature Flags =====
XAGENT_FEATURE_SELF_EVOLUTION=true
XAGENT_FEATURE_SKILL_MARKETPLACE=true
XAGENT_FEATURE_MULTI_AGENT=true
XAGENT_FEATURE_RPA=true
XAGENT_FEATURE_MULTIMODAL=true

# ===== SkillHub =====
XAGENT_SKILLHUB_URL=https://skillhub.cn
XAGENT_SKILLHUB_API_KEY=

# ===== Feishu Integration =====
XAGENT_FEISHU_APP_ID=
XAGENT_FEISHU_APP_SECRET=

# ===== DingTalk Integration =====
XAGENT_DINGTALK_WEBHOOK_URL=

# ===== WeChat Integration =====
XAGENT_WECHAT_APP_ID=
XAGENT_WECHAT_APP_SECRET=

# ===== Email Configuration =====
XAGENT_SMTP_HOST=
XAGENT_SMTP_PORT=587
XAGENT_SMTP_USER=
XAGENT_SMTP_PASSWORD=
XAGENT_EMAIL_FROM=noreply@x-agent.ai

# ===== S3 Storage =====
XAGENT_S3_ENDPOINT=http://localhost:9000
XAGENT_S3_ACCESS_KEY=
XAGENT_S3_SECRET_KEY=
XAGENT_S3_BUCKET=xagent-data
