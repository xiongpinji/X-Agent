{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../frontend/dist"
  },
  "tauri": {
    "windows": [
      {
        "title": "X-Agent",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": false,
        "sidecar": false,
        "scope": []
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true,
        "removeDir": true,
        "removeFile": true,
        "renameFile": true,
        "exists": true,
        "scope": ["$APPDATA/com.xagent.desktop/**"]
      },
      "path": {
        "all": false
      },
      "window": {
        "all": false,
        "create": false,
        "center": false,
        "requestUserAttention": false,
        "setResizable": false,
        "setMaxSize": false,
        "setMinSize": false,
        "setTitle": false,
        "maximize": true,
        "unmaximize": false,
        "minimize": true,
        "unminimize": false,
        "show": true,
        "hide": true,
        "close": true,
        "setDecorations": false,
        "setAlwaysOnTop": false,
        "setContentProtected": false,
        "setFocus": true,
        "setSkipTaskbar": false,
        "setCursorGrab": false,
        "setCursorVisible": false,
        "setCursorIcon": false,
        "setCursorPosition": false,
        "setIgnoreCursorEvents": false,
        "startDragging": false,
        "print": false
      },
      "globalShortcut": {
        "all": true
      },
      "http": {
        "all": false,
        "request": true,
        "scope": ["http://127.0.0.1:8000/**", "http://localhost:8000/**"]
      },
      "notification": {
        "all": false
      },
      "dialog": {
        "all": false,
        "open": false,
        "save": false,
        "message": false,
        "ask": false,
        "confirm": false
      },
      "clipboard": {
        "all": false,
        "readText": false,
        "writeText": false
      }
    },
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis"],
      "identifier": "com.xagent.desktop",
      "icon": [
        "icons/icon.ico"
      ],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "10.13",
        "entitlements": null,
        "signingIdentity": null,
        "providerShortName": null
      },
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "epoch": 0
      }
    }
  },
  "package": {
    "productName": "X-Agent",
    "version": "0.1.0"
  }
}
