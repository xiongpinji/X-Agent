# P1-06: nginx TLS 终结参考配置（X-Agent）
# 放置: /etc/nginx/conf.d/xagent.conf；证书路径与域名按实际修改。

upstream xagent_api {
    server 127.0.0.1:8000;  # 或 compose 网络内 api:8000
    keepalive 32;
}

# HTTP -> HTTPS 强制跳转
server {
    listen 80;
    server_name xagent.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name xagent.example.com;

    ssl_certificate     /etc/letsencrypt/live/xagent.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xagent.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # 安全响应头（应用层已有 CSP；此处只补传输层头）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    client_max_body_size 50m;  # 代码/文件上传上限，按业务调整

    location / {
        proxy_pass http://xagent_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;  # agent run 可能较长
    }

    # SSE 流式端点（/api/v1/streaming/*）禁用缓冲
    location /api/v1/streaming/ {
        proxy_pass http://xagent_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
