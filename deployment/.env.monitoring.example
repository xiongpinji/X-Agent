# X-Agent 监控系统环境变量配置

# Prometheus配置
PROMETHEUS_RETENTION=30d
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# Grafana配置
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SECURITY_ADMIN_USER=admin
GF_INSTALL_PLUGINS=grafana-piechart-panel
GF_PATHS_PROVISIONING=/etc/grafana/provisioning

# AlertManager配置
ALERTMANAGER_CONFIG_FILE=/etc/alertmanager/alertmanager.yml

# 通知配置
# Slack Webhook URL (可选)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty配置 (可选)
PAGERDUTY_SERVICE_KEY=your-service-key

# 邮件配置 (可选)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=alerts@xagent.com

# X-Agent API配置
XAGENT_API_HOST=localhost
XAGENT_API_PORT=8000
XAGENT_METRICS_ENABLED=true

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/xagent

# Redis配置 (可选)
REDIS_URL=redis://localhost:6379

# Langfuse配置
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# 性能配置
METRICS_COLLECTION_ENABLED=true
HEALTH_CHECK_INTERVAL=30s
METRICS_EXPORT_INTERVAL=15s

# 告警配置
ALERT_EVALUATION_INTERVAL=30s
ALERT_FOR_DURATION=5m

# 存储配置
PROMETHEUS_STORAGE_PATH=/prometheus
GRAFANA_STORAGE_PATH=/var/lib/grafana
ALERTMANAGER_STORAGE_PATH=/alertmanager

# 网络配置
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
NODE_EXPORTER_PORT=9100

# 安全配置
ENABLE_HTTPS=false
CERT_FILE=/etc/ssl/certs/cert.pem
KEY_FILE=/etc/ssl/private/key.pem

# 调试配置
DEBUG=false
VERBOSE_LOGGING=false
